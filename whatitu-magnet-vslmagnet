r,.content,.card{background:#0e1d2e;border:1px solid var(--line);border-radius:17px}.sidebar{padding:14px;height:max-content;position:sticky;top:12px}.side-label{color:#7893ad;font-size:10px;letter-spacing:1.7px;font-weight:800;padding:10px 9px 6px}.nav{width:100%;display:flex;gap:10px;text-align:left;background:transparent;border:0;color:#b7c9dc;padding:10px;border-radius:9px}.nav.active,.nav:hover{background:#18334e;color:white}.num{font-size:11px;color:var(--cyan);width:22px}.content{padding:22px;min-height:500px}.section-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:18px}.section-head h2{margin:0;font-size:26px}.section-head p,.card p{margin:5px 0;color:var(--muted)}.grid2{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px}.card{padding:16px;background:linear-gradient(145deg,#12243a,#0e1b2c)}.card h3{margin:0 0 7px;font-size:16px}.callout{border-left:3px solid var(--cyan);background:#102c40;padding:12px 14px;border-radius:0 10px 10px 0;margin:12px 0}.warning{border-color:var(--gold);background:#302817}.steps{padding-left:24px;color:#c4d3e2}.steps li{margin:9px 0}.controls{display:flex;gap:9px;flex-wrap:wrap;align-items:center;margin:12px 0}.field{display:flex;flex-direction:column;gap:4px;color:var(--muted);font-size:12px}.field input,.field select,.field textarea{background:#091827;border:1px solid var(--line);color:var(--text);border-radius:8px;padding:9px}.field textarea,textarea{min-height:70px;width:100%;background:#091827;border:1px solid var(--line);color:white;border-radius:8px;padding:9px}.field input[type=range]{padding:0;accent-color:var(--cyan)}.table-wrap{overflow:auto;margin:12px 0}table{border-collapse:collapse;width:100%;font-size:13px}th,td{border-bottom:1px solid #263c52;padding:9px;text-align:left}th{color:var(--cyan)}td input{width:75px;background:#091827;color:white;border:1px solid var(--line);border-radius:6px;padding:6px}.visual{background:#071522;border:1px solid #27435d;border-radius:14px;padding:12px;min-height:210px;display:grid;place-items:center;overflow:hidden}.visual svg{width:100%;max-height:290px}.material-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}.material{padding:11px 7px;text-align:center;border:1px solid var(--line);border-radius:10px;background:#10243a}.material b{display:block;font-size:21px}.material small,.small{color:var(--muted);font-size:12px}.result{font-weight:700;color:var(--green);margin-top:8px}.experiment-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.exp-card{display:flex;gap:12px;align-items:flex-start;padding:13px;background:#12243a;border:1px solid var(--line);border-radius:12px;text-align:left}.exp-card:hover{border-color:var(--cyan)}.exp-icon{font-size:25px}.exp-card strong{display:block}.exp-card small{color:var(--muted)}.progress{height:7px;background:#23364b;border-radius:99px;overflow:hidden}.progress span{display:block;height:100%;background:linear-gradient(90deg,var(--cyan),var(--blue));width:0}.mode{display:flex;background:#0a1928;border:1px solid var(--line);border-radius:10px;padding:3px}.mode button{border:0;background:transparent;padding:6px 9px;font-size:12px}.mode button.selected{background:#204664}.quiz-q{padding:15px;border:1px solid var(--line);border-radius:12px;margin:12px 0;background:#102137}.quiz-q label{display:block;padding:6px 8px;color:#c9d7e5}.quiz-q input{accent-color:var(--cyan)}.feedback{font-size:12px;margin-top:8px}.badge{display:inline-block;padding:3px 7px;border-radius:6px;background:#183c50;color:var(--cyan);font-size:11px}.muted{color:var(--muted)}.footer{color:#6f89a3;text-align:center;font-size:11px;padding:25px 0}@media(max-width:850px){.layout{grid-template-columns:1fr}.sidebar{position:static;display:grid;grid-template-columns:repeat(2,1fr)}.side-label{grid-column:1/-1}.hero{grid-template-columns:1fr}.hero-art{min-height:100px}.grid2{grid-template-columns:1fr}}@media(max-width:560px){.wrap{padding:12px}.content{paddi