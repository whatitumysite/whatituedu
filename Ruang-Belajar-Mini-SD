<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Ruang Belajar SD</title>
<style>
:root{--p:#7257d8;--ink:#252b45;--muted:#69738b;--line:#e7e8f2;--bg:#f6f7ff}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.6 system-ui,sans-serif}.wrap{max-width:1150px;margin:auto;padding:20px}button{font:inherit;cursor:pointer;border:0;border-radius:12px;padding:10px 14px;background:#eeeaff;color:#503db0;font-weight:650}button.primary{background:var(--p);color:white}.top{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px;gap:12px}.brand{display:flex;align-items:center;gap:12px}.logo{background:linear-gradient(135deg,#9d8bf3,#5d46c2);color:white;border-radius:15px;padding:10px;font-size:24px}.brand h1{font-size:19px;margin:0}.brand p{margin:0;color:var(--muted);font-size:12px}.chip{background:white;border:1px solid var(--line);padding:7px 11px;border-radius:30px;color:var(--muted);font-size:12px}.hero{background:linear-gradient(115deg,#44328e,#7962db 65%,#a28ff3);color:white;border-radius:24px;padding:28px;display:grid;grid-template-columns:1fr auto;gap:15px}.hero h2{font-size:clamp(28px,5vw,44px);line-height:1.1;margin:8px 0}.hero p{color:#eeeaff;max-width:650px}.art{font-size:85px;align-self:center}.stats{display:flex;gap:9px;flex-wrap:wrap}.stat{background:#ffffff20;border:1px solid #ffffff40;padding:7px 12px;border-radius:11px;font-size:12px}.layout{display:grid;grid-template-columns:210px 1fr;gap:15px;margin-top:16px}.side,.main{background:white;border:1px solid var(--line);border-radius:18px;padding:15px}.side{height:max-content;position:sticky;top:10px}.nav{display:block;width:100%;text-align:left;margin:4px 0;background:transparent;color:#59637c}.nav.active,.nav:hover{background:#f0edff;color:#513bb5}.main{padding:22px;min-height:480px}.head{margin-bottom:17px}.head small{color:var(--p);font-weight:800;letter-spacing:1.5px}.head h2{margin:2px 0;font-size:25px}.head p,.card p{color:var(--muted);margin:4px 0}.subjects{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.card{border:1px solid var(--line);border-radius:15px;padding:15px;background:white}.subject{text-align:left;cursor:pointer}.subject:hover{border-color:#b9adf3;transform:translateY(-2px)}.emoji{font-size:29px}.subject h3{margin:4px 0}.subject small{color:var(--muted)}.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}.lesson{display:flex;justify-content:space-between;align-items:center;width:100%;text-align:left;margin:8px 0;background:#fafaff;border:1px solid var(--line);color:var(--ink)}.lesson small{display:block;color:var(--muted);font-weight:400}.callout,.example{padding:12px 14px;background:#f2efff;border-left:4px solid #927cf0;border-radius:0 12px 12px 0;margin:14px 0}.quiz{border:1px solid var(--line);padding:14px;border-radius:13px;margin:12px 0}.quiz label{display:block;padding:6px}.quiz input{accent-color:var(--p)}.feedback{font-weight:700;margin:8px 0}.progress{height:8px;background:#eeeef6;border-radius:20px;overflow:hidden}.progress span{display:block;height:100%;background:var(--p)}.footer{text-align:center;color:#8991a5;font-size:11px;padding:20px}
@media(max-width:780px){.layout{grid-template-columns:1fr}.side{position:static;display:grid;grid-template-columns:repeat(2,1fr)}.subjects{grid-template-columns:repeat(2,1fr)}.art{display:none}}@media(max-width:520px){.wrap{padding:11px}.main{padding:14px}.subjects,.grid{grid-template-columns:1fr}.hero{padding:20px}}
</style></head>
<body><div class="wrap">
<header class="top"><div class="brand"><div class="logo">🎒</div><div><h1>Ruang Belajar SD</h1><p>Belajar jadi mudah, seru, dan menyenangkan!</p></div></div><span class="chip" id="score">⭐ 0 poin</span></header>
<section class="hero"><div><small>AYO BELAJAR BERSAMA!</small><h2>Jelajahi ilmu dengan cara yang menyenangkan.</h2><p>Pilih mata pelajaran, baca materi singkat, lalu uji pemahamanmu lewat kuis interaktif. Semangat belajar!</p><div class="stats"><span class="stat">6 mata pelajaran</span><span class="stat">12+ materi belajar</span><span class="stat">Kuis interaktif</span></div></div><div class="art">📚🪄</div></section>
<div class="layout"><aside class="side"><button class="nav active" onclick="home()">🏠 Beranda</button><button class="nav" onclick="subjectsPage()">📚 Mata pelajaran</button><button class="nav" onclick="mixedQuiz()">🧠 Kuis campuran</button><button class="nav" onclick="progressPage()">🏆 Progres belajar</button><div class="callout">💡 Baca materi, pahami contohnya, lalu kerjakan kuis. Tidak perlu terburu-buru 😊</div></aside><main class="main" id="main"></main></div>
<div class="footer">RUANG BELAJAR SD • Belajar dengan gembira setiap hari 🌈</div></div>
<script>
const S=[
{id:'indo',n:'Bahasa Indonesia',e:'✍️',d:'Membaca, menulis, dan memahami cerita.',L:[
['Mengenal kalimat','Kalimat adalah susunan kata yang memiliki makna. Kalimat biasanya diawali huruf kapital dan diakhiri tanda baca.','Contoh: “Ibu memasak nasi.” Kalimat tersebut memberi informasi tentang kegiatan ibu.',['Kalimat yang baik memiliki ...',['Susunan kata bermakna','Huruf acak','Angka saja'],0,'Kalimat menyampaikan makna atau pesan.']],
['Kata benda dan kata kerja','Kata benda menyebut nama orang, hewan, tempat, atau benda. Kata kerja menunjukkan kegiatan atau tindakan.','Contoh kata benda: buku, kucing, sekolah. Kata kerja: membaca, berlari, menulis.',['Manakah yang termasuk kata kerja?',['Meja','Berlari','Pensil'],1,'Berlari menunjukkan suatu kegiatan.']],
['Ide pokok','Ide pokok adalah gagasan utama yang dibahas dalam sebuah paragraf. Kalimat lain biasanya menjelaskan ide pokok.','Tanyakan: “Apa hal utama yang sedang dibicarakan?”',['Ide pokok adalah ...',['Hiasan paragraf','Gagasan utama','Judul buku saja'],1,'Ide pokok merupakan gagasan utama paragraf.']]
]},
{id:'mtk',n:'Matematika',e:'➗',d:'Berhitung dan memecahkan soal.',L:[
['Penjumlahan','Penjumlahan adalah kegiatan menggabungkan dua bilangan atau lebih. Tanda penjumlahan adalah +.','Contoh: 12 + 5 = 17.',['Hasil dari 8 + 7 adalah ...',['14','15','16'],1,'8 ditambah 7 sama dengan 15.']],
['Pengurangan','Pengurangan berarti mengambil sebagian dari jumlah semula. Tanda pengurangan adalah −.','Contoh: 15 − 6 = 9. Jika ada 15 permen lalu 6 dimakan, tersisa 9.',['Hasil dari 20 − 8 adalah ...',['12','13','14'],0,'20 dikurangi 8 sama dengan 12.']],
['Bangun datar','Bangun datar adalah bentuk dua dimensi yang memiliki panjang dan lebar. Contohnya persegi, persegi panjang, segitiga, dan lingkaran.','Persegi memiliki empat sisi sama panjang. Segitiga memiliki tiga sisi.',['Bangun datar yang memiliki tiga sisi adalah ...',['Persegi','Lingkaran','Segitiga'],2,'Segitiga memiliki tiga sisi.']]
]},
{id:'ipa',n:'IPAS / IPA',e:'🌱',d:'Mengenal alam, tubuh, hewan, dan tumbuhan.',L:[
['Bagian tubuh tumbuhan','Akar menyerap air dan zat hara. Batang menopang tumbuhan. Daun membantu tumbuhan membuat makanan dengan bantuan cahaya matahari.','Bunga berperan dalam perkembangbiakan. Buah dapat melindungi biji.',['Bagian tumbuhan yang menyerap air dari tanah adalah ...',['Daun','Akar','Bunga'],1,'Akar menyerap air dan zat hara dari tanah.']],
['Pancaindra','Manusia memiliki lima indra: mata untuk melihat, telinga untuk mendengar, hidung untuk mencium, lidah untuk mengecap, dan kulit untuk merasakan sentuhan.','Jagalah kesehatan indra dengan kebiasaan bersih dan aman.',['Kita mendengar suara menggunakan ...',['Mata','Kulit','Telinga'],2,'Telinga berfungsi untuk mendengar.']],
['Daur hidup kupu-kupu','Kupu-kupu mengalami metamorfosis sempurna: telur, ulat, kepompong, lalu kupu-kupu dewasa.','Perubahan bentuk tubuh dalam daur hidup ini disebut metamorfosis.',['Tahap setelah ulat adalah ...',['Telur','Kepompong','Kupu-kupu dewasa'],1,'Ulat berubah menjadi kepompong sebelum menjadi kupu-kupu.']]
]},
{id:'ips',n:'IPS',e:'🌏',d:'Belajar tentang lingkungan dan masyarakat.',L:[
['Lingkungan sekitar','Lingkungan adalah segala sesuatu yang ada di sekitar kita. Lingkungan dapat berupa lingkungan alam dan buatan.','Sungai dan hutan termasuk lingkungan alam. Jalan dan jembatan termasuk lingkungan buatan.',['Contoh lingkungan buatan adalah ...',['Hutan','Gunung','Jembatan'],2,'Jembatan dibuat oleh manusia.']],
['Arah mata angin','Empat arah mata angin utama adalah utara, timur, selatan, dan barat. Arah mata angin membantu menentukan lokasi.','Pada peta biasa, utara umumnya di atas, selatan di bawah, timur di kanan, dan barat di kiri.',['Arah berlawanan dengan utara adalah ...',['Selatan','Timur','Barat'],0,'Selatan berlawanan arah dengan utara.']]
]},
{id:'ppkn',n:'Pendidikan Pancasila',e:'🤝',d:'Belajar aturan, tanggung jawab, dan hidup rukun.',L:[
['Hidup rukun','Hidup rukun berarti saling menghormati, menyayangi, dan bekerja sama meskipun memiliki perbedaan.','Contohnya bermain bersama tanpa membeda-bedakan teman dan menyelesaikan masalah dengan musyawarah.',['Sikap yang menunjukkan hidup rukun adalah ...',['Mengejek teman','Membantu teman','Bertengkar'],1,'Membantu teman menunjukkan kepedulian dan kerukunan.']],
['Aturan di sekolah','Aturan dibuat agar kegiatan di sekolah berjalan tertib, aman, dan nyaman. Semua warga sekolah perlu mematuhinya.','Contoh: datang tepat waktu, menjaga kebersihan, dan menghormati guru serta teman.',['Mengapa kita perlu menaati aturan sekolah?',['Agar tertib dan aman','Agar bebas mengganggu','Agar tidak belajar'],0,'Aturan membantu menjaga ketertiban dan keamanan.']]
]},
{id:'eng',n:'Bahasa Inggris',e:'🔤',d:'Mengenal kosakata dan ungkapan sederhana.',L:[
['Greetings (Salam)','Kita menggunakan sapaan untuk menyapa orang lain. “Good morning” berarti selamat pagi. “Good afternoon” berarti selamat siang atau sore.','“Hello” berarti halo. “Good night” digunakan saat berpisah atau menjelang tidur pada malam hari.',['Arti “Good morning” adalah ...',['Selamat pagi','Selamat malam','Sampai jumpa'],0,'Good morning berarti selamat pagi.']],
['Numbers (Angka)','Numbers adalah angka dalam Bahasa Inggris. One = satu, two = dua, three = tiga, four = empat, five = lima.','Hitung benda di sekitarmu lalu sebutkan jumlahnya dalam Bahasa Inggris.',['Bahasa Inggris dari “tiga” adalah ...',['Two','Three','Four'],1,'Three berarti tiga.']]
]}
];
const Q=[['Hasil 6 + 9 adalah ...',['14','15','16'],1,'6 + 9 = 15.'],['Indra untuk melihat adalah ...',['Mata','Telinga','Hidung'],0,'Mata digunakan untuk melihat.'],['Bahasa Inggris dari “satu” adalah ...',['One','Two','Three'],0,'One berarti satu.'],['Lambang sila pertama Pancasila adalah ...',['Bintang','Rantai','Pohon beringin'],0,'Sila pertama dilambangkan dengan bintang.'],['Arah berlawanan dari timur adalah ...',['Utara','Barat','Selatan'],1,'Barat berlawanan arah dengan timur.'],['Kata kerja terdapat pada pilihan ...',['Buku','Tidur','Rumah'],1,'Tidur merupakan kegiatan.']];
let pts=0,done=new Set(),sub=null;
const main=document.getElementById('main');
function header(k,t,d){return `<div class="head"><small>${k}</small><h2>${t}</h2><p>${d}</p></div>`}
function home(){main.innerHTML=header('SELAMAT DATANG','Halo, Teman Belajar! 👋','Hari ini mau belajar apa? Pilih mata pelajaran favoritmu.')+`<div class="grid"><div class="card"><b>🚀 MULAI BELAJAR</b><h3>Belajar sedikit demi sedikit</h3><p>Pilih materi, baca penjelasannya, dan jawab pertanyaannya.</p><button class="primary" onclick="subjectsPage()">Pilih pelajaran →</button></div><div class="card"><b>⭐ POINMU</b><h3>${pts} poin terkumpul</h3><p>Jawab kuis dengan benar untuk mendapat poin.</p><div class="progress"><span style="width:${Math.min(100,pts*2)}%"></span></div></div></div><h3>Mata pelajaran</h3><div class="subjects">${S.map(s=>`<button class="card subject" onclick="openSub('${s.id}')"><div class="emoji">${s.e}</div><h3>${s.n}</h3><small>${s.d}</small></button>`).join('')}</div><div class="callout">💡 Tips: Belajar dengan tenang, tanyakan hal yang belum dipahami, dan jangan takut salah. Kesalahan adalah bagian dari belajar!</div>`}
function subjectsPage(){main.innerHTML=header('PILIH PELAJARAN','Mata Pelajaran SD','Pilih mata pelajaran untuk melihat daftar materi.')+`<div class="subjects">${S.map(s=>`<button class="card subject" onclick="openSub('${s.id}')"><div class="emoji">${s.e}</div><h3>${s.n}</h3><small>${s.d}</small></button>`).join('')}</div>`}
function openSub(id){sub=S.find(s=>s.id===id);main.innerHTML=`<button onclick="subjectsPage()">← Semua pelajaran</button>`+header(sub.e+' '+sub.n.toUpperCase(),'Pilih materi yang ingin kamu pelajari.','DAFTAR MATERI')+sub.L.map((l,i)=>`<button class="lesson" onclick="lesson(${i})"><span><b>${i+1}. ${l[0]}</b><small>${done.has(id+'-'+i)?'✓ Sudah dipelajari':'Baca materi dan kerjakan kuis singkat'}</small></span>›</button>`).join('')}
function lesson(i){let l=sub.L[i],key=sub.id+'-'+i;main.innerHTML=`<button onclick="openSub('${sub.id}')">← Kembali ke materi</button>`+header('MATERI BELAJAR',l[0],sub.n)+`<div class="card"><p>${l[1]}</p><div class="example"><b>🌟 Contoh / Ingat!</b><br>${l[2]}</div><h3>Yuk, cek pemahamanmu!</h3><div class="quiz"><b>${l[3][0]}</b>${l[3][1].map((o,j)=>`<label><input type="radio" name="la" value="${j}"> ${'ABC'[j]}. ${o}</label>`).join('')}<div class="feedback" id="lf"></div><button class="primary" onclick="checkLesson(${l[3][2]},'${key}')">Periksa jawaban</button></div></div>`}
function checkLesson(ans,key){let c=document.querySelector('input[name=la]:checked'),f=document.getElementById('lf');if(!c){f.textContent='Pilih jawaban dahulu ya!';return}if(+c.value===ans){f.textContent='🎉 Benar! Hebat sekali!';f.style.color='green';if(!done.has(key)){done.add(key);pts+=10;score()}}else{f.textContent='Belum tepat. Coba baca lagi materinya, ya. Semangat!';f.style.color='#b7791f'}}
function mixedQuiz(){main.innerHTML=header('UJI PENGETAHUAN','Kuis Campuran 🧠','Jawab enam pertanyaan dari berbagai mata pelajaran.')+Q.map((q,i)=>`<div class="quiz"><b>${i+1}. ${q[0]}</b>${q[1].map((o,j)=>`<label><input type="radio" name="q${i}" value="${j}"> ${'ABC'[j]}. ${o}</label>`).join('')}<div id="f${i}" class="feedback"></div></div>`).join('')+`<button class="primary" onclick="grade()">Periksa semua jawaban</button><div id="result"></div>`}
function grade(){let n=0;Q.forEach((q,i)=>{let c=document.querySelector('input[name=q'+i+']:checked'),ok=c&&+c.value===q[2];if(ok)n++;let f=document.getElementById('f'+i);f.textContent=(ok?'✓ Benar! ':'✗ Belum tepat. ')+q[3];f.style.color=ok?'green':'#b7791f'});pts+=n*5;score();document.getElementById('result').innerHTML=`<div class="callout"><b>Nilaimu: ${n}/6</b><br>Kamu mendapat ${n*5} poin. ${n>=5?'Luar biasa!':'Terus berlatih, kamu pasti bisa!'}</div>`}
function progressPage(){main.innerHTML=header('PERJALANAN BELAJAR','Progres Belajarmu 🏆','Lihat pencapaian yang sudah kamu kumpulkan.')+`<div class="grid"><div class="card"><div class="emoji">⭐</div><h3>${pts} poin</h3><p>Total poin yang kamu dapatkan.</p></div><div class="card"><div class="emoji">📖</div><h3>${done.size} materi</h3><p>Materi yang berhasil kamu selesaikan.</p></div></div><div class="callout">Terus belajar dan coba materi lainnya. Setiap langkah kecil membuatmu semakin pintar! 🌱</div><button class="primary" onclick="subjectsPage()">Lanjut belajar</button>`}
function score(){document.getElementById('score').textContent='⭐ '+pts+' poin'}
home();
</script></body></html>